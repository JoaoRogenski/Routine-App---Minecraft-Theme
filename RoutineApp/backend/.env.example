# Copy to .env (never commit it) and load with: node --env-file=.env server.mjs
PORT=8787
# Long random string; paste the same value in the app (Configurações > Servidor > Token)
APP_TOKEN=change-me-to-a-long-random-string

# --- AI (optional) ---
# anthropic | openai  (openai = any OpenAI-compatible API: OpenAI, Ollama, LM Studio, OpenRouter)
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-haiku-5-5
# only for AI_PROVIDER=openai, e.g. http://localhost:11434/v1 for Ollama
AI_BASE_URL=

# --- Phone calls via Twilio (optional, paid per call) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# a Twilio number you own, E.164
TWILIO_FROM=
# comma-separated E.164 numbers this server may call (recommended: just yours)
ALLOWED_NUMBERS=
CALLS_PER_HOUR=10
